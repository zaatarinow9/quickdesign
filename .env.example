# ---------------------------------------------------------------
# QuickDesign – Umgebungsvariablen (Vercel → Settings → Environment Variables)
# Niemals echte Schlüssel ins Repository einchecken.
# ---------------------------------------------------------------

# Öffentliche Adresse der Website (ohne Slash am Ende)
NEXT_PUBLIC_SITE_URL=https://quickdesign24.de

# Supabase (Dashboard → Project Settings → API Keys) – Projekt „QuickDesign“
NEXT_PUBLIC_SUPABASE_URL=https://sdayndvgwhqjsroyqxlg.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_fGdbwS_t4VtTvAGKqd5YUA_nDMY_9rs
# GEHEIM – nur serverseitig ("Secret key" sb_secret_... oder Legacy service_role)
SUPABASE_SECRET_KEY=

# Inhaber mit vollem Zugriff auf /admin (kommagetrennt)
ADMIN_EMAILS=info@quickdesign24.de

# E-Mail-Versand über das Postfach info@quickdesign24.de (SMTP-Daten des Mail-Anbieters)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@quickdesign24.de
SMTP_PASS=
SMTP_FROM="QuickDesign <info@quickdesign24.de>"
# Optional: Empfänger für Kontaktanfragen (Standard: info@quickdesign24.de)
CONTACT_RECIPIENT=

# Zufallswert zum Pseudonymisieren von IP-Adressen (z. B. openssl rand -hex 32)
IP_HASH_SALT=
# Schutz für den täglichen Lösch-Job (Vercel setzt den Header automatisch)
CRON_SECRET=
